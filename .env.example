# ------------------------------------------------------------------------------
# 7. GOOGLE SIGN-IN & OAUTH 2.0 SETTINGS
# ------------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Add authorized JavaScript origins:
#   - http://localhost:3000
#   - https://cricpavilion-750c5.firebaseapp.com
#   - https://cricpavilion-750c5.web.app
GOOGLE_OAUTH_CLIENT_ID=353831839667-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 8. FIREBASE PHONE AUTHENTICATION (SMS OTP)
# ------------------------------------------------------------------------------
# NOTE: To send REAL SMS to mobile devices in India (+91):
#   1. Firebase Console > Authentication > Settings > SMS Region Policy:
#      Select "Allow specific countries" and ensure "India (+91)" is enabled
#      (prevents [firebase_auth/operation-not-allowed]).
#   2. Google Cloud / Firebase Billing:
#      Requires Blaze (Pay-As-You-Go) Plan for real telecom SMS delivery
#      (prevents [firebase_auth/billing-not-enabled]).
#   3. Free Testing without Blaze Billing:
#      Firebase Console > Authentication > Sign-in method > Phone > Phone numbers for testing:
#      Example: +91 9014842370 with Verification Code: 123456
FIREBASE_PHONE_TEST_NUMBER=+919014842370
FIREBASE_PHONE_TEST_CODE=123456
